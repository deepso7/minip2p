{
  "name": "react-native-minip2p",
  "version": "0.1.0",
  "description": "React Native bindings for minip2p",
  "keywords": [
    "android",
    "ios",
    "libp2p",
    "p2p",
    "peer-to-peer",
    "quic",
    "react-native",
    "rust",
    "uniffi"
  ],
  "homepage": "https://github.com/deepso7/minip2p#readme",
  "bugs": {
    "url": "https://github.com/deepso7/minip2p/issues"
  },
  "license": "MIT",
  "author": "Deepso <deeps.o7o8.y@gmail.com> (https://github.com/deepso7)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepso7/minip2p.git"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "build/Minip2pFfi.xcframework",
    "cpp",
    "*.podspec",
    "NOTICE",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-minip2p-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "example": "pnpm --filter react-native-minip2p-example",
    "ubrn:generate": "node scripts/generate-bindings.mjs",
    "ubrn:ios": "IPHONEOS_DEPLOYMENT_TARGET=15.1 ubrn build ios --config ubrn.config.yaml --and-generate && node scripts/normalize-generated.mjs",
    "ubrn:android": "env -u LIBCLANG_PATH ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ANDROID_NDK_HOME=${ANDROID_NDK_HOME:-$HOME/Library/Android/sdk/ndk/28.2.13676358} ubrn build android --config ubrn.config.yaml --and-generate && node scripts/normalize-generated.mjs",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepack": "node scripts/check-package-native.mjs",
    "prepare": "bob build && node scripts/normalize-generated.mjs",
    "typecheck": "tsc",
    "lint": "ultracite check",
    "format": "ultracite fix"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-3",
    "uniffi-bindgen-react-native": "0.31.0-3"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "codegenConfig": {
    "name": "Minip2pSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.minip2p"
    },
    "includesGeneratedCode": true
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "tools": [],
    "version": "0.63.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ],
      "codegen"
    ]
  }
}
