{
  "name": "@minip2p/react-native",
  "version": "0.4.6",
  "description": "React Native bindings for minip2p",
  "keywords": [
    "android",
    "ios",
    "libp2p",
    "p2p",
    "peer-to-peer",
    "quic",
    "react-native",
    "rust",
    "uniffi"
  ],
  "homepage": "https://github.com/deepso7/minip2p#readme",
  "bugs": {
    "url": "https://github.com/deepso7/minip2p/issues"
  },
  "license": "MIT",
  "author": "Deepso <deeps.o7o8.y@gmail.com> (https://github.com/deepso7)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepso7/minip2p.git",
    "directory": "bindings/ts/react-native"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "build/Minip2pFfi.xcframework",
    "cpp",
    "*.podspec",
    "NOTICE",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-minip2p-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./native": {
      "react-native-minip2p-source": "./src/low-level.ts",
      "types": "./lib/typescript/src/low-level.d.ts",
      "default": "./lib/module/low-level.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "example": "pnpm --filter react-native-minip2p-example",
    "ubrn:generate": "node scripts/generate-bindings.mjs",
    "ubrn:ios": "IPHONEOS_DEPLOYMENT_TARGET=15.1 ubrn build ios --release --config ubrn.config.yaml --and-generate && node scripts/normalize-generated.mjs && node scripts/generate-codegen.mjs && node scripts/normalize-generated.mjs",
    "ubrn:android": "env -u LIBCLANG_PATH ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ANDROID_NDK_HOME=${ANDROID_NDK_HOME:-$HOME/Library/Android/sdk/ndk/28.2.13676358} ubrn build android --release --config ubrn.config.yaml --and-generate && node scripts/normalize-generated.mjs && node scripts/generate-codegen.mjs && node scripts/normalize-generated.mjs",
    "clean": "del-cli android/.cxx android/build example/android/build example/android/app/build example/ios/build lib",
    "build": "bob build && node scripts/normalize-generated.mjs",
    "prepack": "pnpm build && node scripts/check-package-native.mjs",
    "test": "vitest run --config ../vitest.config.ts --root .",
    "test:built": "vitest run --config vitest.built.config.ts --root .",
    "test:watch": "vitest --config ../vitest.config.ts --root .",
    "typecheck": "tsc",
    "lint": "ultracite check",
    "format": "ultracite fix"
  },
  "dependencies": {
    "@minip2p/core": "workspace:*",
    "@ubjs/core": "0.31.0-5",
    "uniffi-bindgen-react-native": "0.31.0-5"
  },
  "devDependencies": {
    "@minip2p/test-fixtures": "workspace:*",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/react": "catalog:",
    "del-cli": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "0.43.0",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "Minip2pSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.minip2p"
    },
    "includesGeneratedCode": true
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "tools": [],
    "version": "0.63.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
