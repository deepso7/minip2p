{
  "extends": "../../../.config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@minip2p/react-native": ["./src/index"]
    },
    "customConditions": [
      "minip2p-source",
      "react-native-minip2p-source",
      "react-native-strict-api"
    ],
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ESNext"
  }
}
