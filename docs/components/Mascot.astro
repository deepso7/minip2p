---
// A cursor-tracking mascot: the head turns toward the pointer and reacts when
// clicked. Each character is two 3×3 sprite sheets (nine head directions, nine
// expressions); frames swap by moving `background-position`. Vanilla port of
// page-mascot's React component, so the page ships no framework JS.
interface Props {
  /** Served path of the 3×3 head-directions sheet. */
  directions: string;
  /** Served path of the 3×3 expressions sheet. */
  reactions: string;
  /** Width over height of one frame. The mascot fills its container's width. */
  aspect?: number;
  class?: string;
  /** What a screen reader calls it. */
  label?: string;
}

const { directions, reactions, aspect = 1, class: className, label = "mascot" } = Astro.props;
---

<button
  type="button"
  class:list={["mascot", className]}
  aria-label={`Boop the ${label}`}
  style={`aspect-ratio: ${aspect}`}
  data-mascot
>
  <span class="mascot-squash">
    <span class="mascot-layer" data-layer="directions" style={`background-image: url(${directions}); background-position: 50% 50%`}></span>
    <!-- Always present so the sheet is fetched up front, never on the first click. -->
    <span class="mascot-layer" data-layer="reactions" style={`background-image: url(${reactions}); opacity: 0`}></span>
  </span>
</button>

<style>
  .mascot {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
    user-select: none;
  }
  .mascot-squash {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 78%;
  }
  .mascot-layer {
    position: absolute;
    inset: 0;
    background-size: 300% 300%;
    background-repeat: no-repeat;
  }
</style>

<script>
  const DIRECTIONS = ["up-left", "up", "up-right", "left", "center", "right", "down-left", "down", "down-right"] as const;
  const REACTIONS = ["blink", "heart", "sparkle", "surprised", "wink", "bashful", "sleepy", "dizzy", "delighted"] as const;
  type Direction = (typeof DIRECTIONS)[number];
  type Reaction = (typeof REACTIONS)[number];

  // Clockwise from the right, matching atan2 with y pointing down.
  const CLOCKWISE: Direction[] = ["right", "down-right", "down", "down-left", "left", "up-left", "up", "up-right"];
  const SECTOR = (Math.PI * 2) / CLOCKWISE.length;
  const HYSTERESIS = 0.12;
  const DEAD_ZONE = 70;

  const PAYOFFS: Reaction[] = ["heart", "sparkle", "delighted"];
  const BOOP_PAYOFF = 120;
  const BOOP_END = 560;
  const DIZZY_AFTER = 4;
  const DIZZY_WINDOW = 1600;
  const DIZZY_END = 1100;
  const SQUASH: Keyframe[] = [
    { transform: "scale(1, 1)", easing: "ease-in" },
    { transform: "scale(1.10, 0.86)", offset: 0.18, easing: "ease-out" },
    { transform: "scale(0.95, 1.08)", offset: 0.45, easing: "ease-in-out" },
    { transform: "scale(1.03, 0.97)", offset: 0.72, easing: "ease-in-out" },
    { transform: "scale(1, 1)" },
  ];

  // background-size 300% makes each cell a clean 0/50/100% step on both axes.
  const cell = (index: number) => `${(index % 3) * 50}% ${Math.floor(index / 3) * 50}%`;
  const wrap = (angle: number) => Math.atan2(Math.sin(angle), Math.cos(angle));

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-mascot]")) {
    const squash = button.querySelector<HTMLElement>(".mascot-squash")!;
    const head = button.querySelector<HTMLElement>('[data-layer="directions"]')!;
    const face = button.querySelector<HTMLElement>('[data-layer="reactions"]')!;

    const look = (direction: Direction) => {
      head.style.backgroundPosition = cell(DIRECTIONS.indexOf(direction));
    };
    const react = (reaction: Reaction | null) => {
      if (reaction) face.style.backgroundPosition = cell(REACTIONS.indexOf(reaction));
      face.style.opacity = reaction ? "1" : "0";
      head.style.opacity = reaction ? "0" : "1";
    };

    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      let sector = -1;
      let pointer: { x: number; y: number } | null = null;

      const aim = () => {
        if (!pointer) return;
        const box = button.getBoundingClientRect();
        const dx = pointer.x - (box.left + box.width / 2);
        const dy = pointer.y - (box.top + box.height / 2);

        if (Math.hypot(dx, dy) < DEAD_ZONE) {
          sector = -1;
          look("center");
          return;
        }

        // Hold the current sector until the pointer is well past its edge.
        const angle = Math.atan2(dy, dx);
        if (sector !== -1 && Math.abs(wrap(angle - sector * SECTOR)) < SECTOR / 2 + HYSTERESIS) return;

        sector = (Math.round(angle / SECTOR) + CLOCKWISE.length) % CLOCKWISE.length;
        look(CLOCKWISE[sector]);
      };

      addEventListener("pointermove", (event) => {
        pointer = { x: event.clientX, y: event.clientY };
        aim();
      }, { passive: true });
      addEventListener("scroll", aim, { passive: true });
    }

    let timers: number[] = [];
    const boops = { count: 0, at: 0 };

    button.addEventListener("click", () => {
      timers.forEach(clearTimeout);
      timers = [];
      const later = (ms: number, next: Reaction | null) => timers.push(setTimeout(() => react(next), ms));

      const now = Date.now();
      boops.count = now - boops.at < DIZZY_WINDOW ? boops.count + 1 : 1;
      boops.at = now;

      if (boops.count >= DIZZY_AFTER) {
        boops.count = 0;
        react("dizzy");
        later(DIZZY_END, null);
      } else {
        react("blink");
        later(BOOP_PAYOFF, PAYOFFS[(boops.count - 1) % PAYOFFS.length]);
        later(BOOP_END, null);
      }

      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      // Per-keyframe easing with the effect itself linear: an easing on the effect
      // would reinterpret every offset and front-load the whole bounce.
      squash.animate(SQUASH, { duration: 420, easing: "linear" });
    });
  }
</script>
