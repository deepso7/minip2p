---
// The `Breadcrumbs` layout slot: the section tabs, then Blume's own eyebrow
// crumb. This slot is the first thing in the content column, so the tabs lead
// every docs and changelog entry page and scroll away with it. (`PageHeader`
// would render below the crumb and the "On this page" dropdown.)
import type { ComponentProps } from "astro/types";
import BlumeBreadcrumbs from "blume/components/layout/Breadcrumbs.astro";
import SectionTabs from "./section-tabs.astro";
import { isBareRoute } from "./shell";

type Props = ComponentProps<typeof BlumeBreadcrumbs>;

const { centered = false, wide = false } = Astro.props;
const route = Astro.url.pathname.replace(/(?<=.)\/$/u, "");
---

{
  !isBareRoute(route) && (
    <SectionTabs
      class:list={[
        "mb-8",
        wide ? "max-w-none" : ["mx-auto", centered ? "max-w-[54rem]" : "max-w-content"],
      ]}
      route={route}
    />
  )
}
<BlumeBreadcrumbs {...Astro.props} />
