---
// The shape of one Connection attempt: direct candidates race a relay leg that
// starts `relay_stagger_ms` later, a circuit carries traffic while DCUtR
// punches, and the attempt ends in exactly one ConnectSettled.
//
// Transform and opacity only, one pass, played when it scrolls into view. What
// the markup describes is the *finished* diagram — paths drawn, chips shown —
// so a browser that never runs the script, or one asking for reduced motion,
// still gets the explanation. The `animate-*` utilities (see theme.css) only
// take over while the story plays, because an animation outranks a plain
// declaration.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// `data-play` starts the story, `data-reset` rewinds it for Replay; both are
// set by the script below on the figure, which is the `group`.
const gate =
  "group-data-play:[animation-play-state:running]! group-data-reset:animate-none!";

const mono = "font-mono text-xs text-muted-foreground";
const lane =
  "grid grid-cols-[11rem_1fr_7rem] items-center gap-4 @max-[34rem]:grid-cols-1 @max-[34rem]:gap-2";
const track = "relative h-[2px] bg-border";
const runner = `absolute inset-y-0 right-[9px] left-0 ${gate}`;
const dot = `absolute -top-1 left-0 size-[9px] rounded-full bg-accent opacity-0 ${gate}`;
const chip =
  "justify-self-start whitespace-nowrap rounded-full border border-border px-2 py-0.5 font-mono text-xs text-muted-foreground";
const liveChip = `${chip} border-accent text-accent ${gate}`;
---

<figure class:list={["group @container m-0", className]} data-attempt>
  <div class="mb-5 flex items-baseline justify-between gap-4">
    <figcaption class={mono}>One attempt, four routes, one outcome</figcaption>
    <button
      type="button"
      class="hidden cursor-pointer rounded-full border border-border px-3 py-1 font-mono text-xs text-muted-foreground group-data-motion:block hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      data-replay
    >Replay</button>
  </div>

  {/* A runner is as wide as its track, so translating it by 100% leaves its
      (invisible) box hanging past the page. Clip that, not the y axis: the dots
      and the punch flash sit above and below the 2px line. */}
  <div class="grid gap-3 overflow-x-clip @max-[34rem]:gap-6">
    <div class={lane}>
      <span class={mono}>QUIC candidate</span>
      <div class={track}>
        <div class={`${runner} group-data-motion:animate-probe`}>
          <span class={`${dot} group-data-motion:animate-probe-dot`}></span>
        </div>
      </div>
      <span class={chip}>no route</span>
    </div>

    <div class={lane}>
      <span class={mono}>TCP candidate</span>
      <div class={track}>
        <div class={`${runner} group-data-motion:animate-probe-late`}>
          <span class={`${dot} group-data-motion:animate-probe-dot-late`}></span>
        </div>
      </div>
      <span class={chip}>no route</span>
    </div>

    <div class={lane}>
      <span class={mono}>relay leg <span class="text-accent">+200 ms</span></span>
      <div class={track}>
        <span
          class={`absolute inset-x-0 top-0 origin-left border-t-2 border-dashed border-accent opacity-25 ${gate} group-data-motion:animate-relay-path`}
        ></span>
        <div class={`${runner} group-data-motion:animate-relay`}>
          <span class={`${dot} group-data-motion:animate-relay-dot`}></span>
        </div>
      </div>
      <span class={`${liveChip} opacity-25 group-data-motion:animate-relay-chip`}>Relayed</span>
    </div>

    <div class={lane}>
      <span class={mono}>DCUtR hole punch</span>
      <div class={track}>
        <span
          class={`absolute inset-0 origin-left bg-accent ${gate} group-data-motion:animate-direct-path`}
        ></span>
        <div class={`${runner} group-data-motion:animate-punch-left`}>
          <span class={`${dot} group-data-motion:animate-punch-dot`}></span>
        </div>
        <div class={`${runner} group-data-motion:animate-punch-right`}>
          <span class={`${dot} right-0 left-auto group-data-motion:animate-punch-dot`}></span>
        </div>
        <span
          class={`absolute -top-1 left-1/2 -ml-[4.5px] size-[9px] rounded-full bg-accent opacity-0 ${gate} group-data-motion:animate-flash`}
        ></span>
      </div>
      <span class={`${liveChip} group-data-motion:animate-direct-chip`}>Direct</span>
    </div>
  </div>

  <p class="mt-5 mb-0 pl-48 @max-[34rem]:pl-0">
    <span class={`${liveChip} group-data-motion:animate-settled-chip`}>ConnectSettled · Connected</span>
  </p>
</figure>

<script>
  const THRESHOLD = 0.35;

  for (const figure of document.querySelectorAll<HTMLElement>("[data-attempt]")) {
    // Scripts run, so the diagram may animate rather than stand finished.
    figure.dataset.motion = "";

    const play = () => {
      figure.dataset.play = "";
    };

    if (typeof IntersectionObserver === "undefined") {
      play();
    } else {
      const seen = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            // `isIntersecting` flips on the first pixel, so wait for the share
            // the threshold asks for — unless the figure is taller than the
            // viewport, where that share can never be reached.
            const readable =
              entry.intersectionRatio >= THRESHOLD ||
              entry.intersectionRect.height >= window.innerHeight * 0.6;
            if (entry.isIntersecting && readable) {
              play();
              observer.disconnect();
            }
          }
        },
        { threshold: [0, THRESHOLD] }
      );
      seen.observe(figure);
    }

    figure.querySelector<HTMLButtonElement>("[data-replay]")?.addEventListener("click", () => {
      // Strip the animations, force a reflow so the removal is observed, then
      // reattach them: pausing and resuming would leave the finished state.
      figure.dataset.reset = "";
      void figure.offsetWidth;
      delete figure.dataset.reset;
      play();
    });
  }
</script>
