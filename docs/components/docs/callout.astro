---
// A callout as a dashed aside: a lowercase mono eyebrow naming the type
// (`note`, `warning`, …) floats into the first line of the message. Notes and
// tips print in the accent, warnings in amber, danger in red. Takes the
// built-in's props; `icon` is accepted and dropped, the eyebrow names the type.
import type { CalloutProps } from "blume/components";

type Props = CalloutProps;

const { color, type = "info", title } = Astro.props;
const tones: Record<string, string> = { danger: "text-danger", warning: "text-warning" };
---

<aside
  class="my-6 flow-root rounded-blume border border-dashed border-border px-3.5 py-2.5 text-sm leading-6 text-muted-foreground"
  data-blume-callout={type}
>
  <span
    class:list={["float-start me-2 font-mono text-xs leading-6 lowercase", tones[type] ?? "text-accent"]}
    style={color ? `color:${color}` : undefined}
  >
    {type}
  </span>
  <div class="[&>*]:mt-2! [&>*]:mb-0! [&>:first-child]:mt-0!">
    {title && <p class="font-medium text-foreground">{title}</p>}
    <slot />
  </div>
</aside>
