---
// A callout as a log line: a level tag (`note:`, `warn:`) and the message,
// coloured by level and hung off a left rule.
import type { CalloutProps } from "blume/components";

type Props = CalloutProps;

const { type = "info", title } = Astro.props;
const level = {
  check: "ok",
  danger: "error",
  info: "info",
  note: "note",
  success: "ok",
  tip: "hint",
  warning: "warn",
}[type] ?? "info";
const tones: Record<string, string> = { error: "term-tone-error", warn: "term-tone-warn" };
const tone = tones[level] ?? "term-tone-signal";
---

<aside
  class:list={["term-callout not-prose my-6 grid gap-x-3 border-s-2 py-2 ps-4 text-sm leading-relaxed sm:grid-cols-[auto_1fr]", tone]}
  data-blume-callout={type}
>
  <span class="term-callout-level font-bold">{level}:</span>
  <div class="text-muted-foreground [&>*]:mt-2! [&>*]:mb-0! [&>:first-child]:mt-0! [&_a]:text-foreground [&_a]:underline [&_code]:text-foreground">
    {title && <p class="font-bold text-foreground">{title}</p>}
    <slot />
  </div>
</aside>
