---
// A grid of Cards: one column on phones, `cols` (default 2) from `sm` up.
import type { CardGroupProps } from "blume/components";

type Props = CardGroupProps;

const { cols = 2 } = Astro.props;
---

<div
  class="my-6 grid grid-cols-1 gap-3 sm:grid-cols-[repeat(var(--cols),minmax(0,1fr))]"
  style={`--cols:${cols}`}
>
  <slot />
</div>
