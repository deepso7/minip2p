---
// One hairline card in a CardGroup (see card-group.astro): an optional quiet
// icon, the title, and its description. A linked card trails an arrow (`↗` for
// an external link) and lifts its border and arrow on hover; `arrow={false}`
// hides it. Takes the built-in's props; `img`, `cta`, `horizontal`, `type`,
// and `color` are accepted and unused by these docs.
import type { CardProps } from "blume/components";
import Icon from "blume/components/Icon.astro";

type Props = CardProps;

const { arrow, href, icon, title } = Astro.props;
const external = href !== undefined && /^https?:\/\//u.test(href);
const showArrow = href !== undefined && arrow !== false && arrow !== "false";
const Tag = href ? "a" : "div";
---

<Tag
  class="group block rounded-blume border border-border p-4 font-normal text-inherit no-underline! transition-colors [&[href]]:hover:border-faint"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  data-blume-card
>
  {icon && <Icon class="mb-3 text-faint transition-colors group-hover:text-foreground" name={icon} size={16} />}
  {
    title && (
      <p class="m-0! flex items-baseline justify-between gap-2 text-base leading-6 font-medium text-foreground">
        {title}
        {showArrow && (
          <span class="text-sm text-faint transition-colors group-hover:text-foreground" aria-hidden="true">
            {external ? "↗" : "→"}
          </span>
        )}
      </p>
    )
  }
  <div class="mt-1 text-sm leading-6 text-muted-foreground [&>*]:my-0!">
    <slot />
  </div>
</Tag>
