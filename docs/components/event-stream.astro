---
// One `wait` call, then the events it hands back in Endpoint emission order.
// Same rules as the attempt diagram: transform and opacity, one pass on reveal,
// last keyframe is the finished state.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure class:list={["stream", className]} data-stream>
  <div class="layout">
    <div class="call">
      <span class="call-label">your loop</span>
      <code>node.wait(deadline)?</code>
    </div>

    <ol class="events">
      <li class="event"><span class="pip"></span><code>ConnectionEstablished</code></li>
      <li class="event"><span class="pip pip-accent"></span><code>Nat(PathUpgraded)</code></li>
      <li class="event event-last"><span class="pip pip-accent"></span><code>ConnectSettled</code></li>
    </ol>
  </div>

  <figcaption>One ordered stream. Every event delivered once.</figcaption>
</figure>

<style>
  /* The figure is the container; the grid inside it is what responds, because
     an element cannot answer its own container query. */
  .stream {
    margin: 0;
    container-type: inline-size;
  }
  .layout {
    display: grid;
    gap: 1rem;
  }
  figcaption {
    margin-top: 1rem;
  }
  .call {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--blume-border);
    border-radius: 0.75rem;
    background: var(--blume-muted);
  }
  .call-label,
  figcaption {
    font-family: var(--blume-font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    color: var(--blume-muted-foreground);
  }
  .call code,
  .event code {
    font-family: var(--blume-font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
  }
  .events {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .event {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--blume-border);
    border-radius: 0.625rem;
    opacity: 0;
  }
  .event-last {
    border-color: var(--blume-accent);
  }
  .pip {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--blume-muted-foreground);
  }
  .pip-accent {
    background: var(--blume-accent);
  }

  @keyframes arrive {
    0% { opacity: 0; transform: translateY(6px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .stream .event {
    animation-play-state: paused;
    animation-fill-mode: both;
    animation-name: arrive;
    animation-duration: var(--minip2p-duration-base);
    animation-timing-function: var(--minip2p-ease);
  }
  .stream[data-play] .event {
    animation-play-state: running;
  }
  .event:nth-child(1) { animation-delay: 120ms; }
  .event:nth-child(2) { animation-delay: 360ms; }
  .event:nth-child(3) { animation-delay: 600ms; }

  @container (min-width: 40rem) {
    .layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: center;
      column-gap: 1.5rem;
    }
  }
</style>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>("[data-stream]")) {
    const play = () => {
      figure.dataset.play = "";
    };

    if (typeof IntersectionObserver === "undefined") {
      play();
      continue;
    }

    const seen = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            play();
            observer.disconnect();
          }
        }
      },
      { threshold: 0.4 }
    );
    seen.observe(figure);
  }
</script>
