---
// The loop: each `wait` call returns one event, in Endpoint emission order.
// Same rules as the attempt diagram — the markup is the finished state, and the
// `animate-*` utilities (theme.css) only take over while it plays.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const gate = "group-data-play:[animation-play-state:running]!";
const mono = "font-mono text-xs text-muted-foreground";
const event = `flex items-center gap-2.5 rounded-[0.625rem] border border-border px-[0.9rem] py-[0.7rem] ${gate}`;
const pip = "size-1.5 shrink-0 rounded-full";
const code = "font-mono text-[0.8125rem]";
---

<figure class:list={["group @container m-0", className]} data-stream>
  {/* The figure is the container; the grid inside it is what responds, because
      an element cannot answer its own container query. */}
  <div class="grid gap-4 @min-[40rem]:grid-cols-[15rem_minmax(0,1fr)] @min-[40rem]:items-center @min-[40rem]:gap-x-6">
    <div class="grid gap-1.5 rounded-xl border border-border bg-muted px-[1.15rem] py-4">
      <span class={mono}>your loop</span>
      <code class={code}>match node.wait(deadline)? &#123; … &#125;</code>
    </div>

    <ol class="m-0 grid list-none gap-2 p-0">
      <li class={`${event} group-data-motion:animate-event-first`}>
        <span class={`${mono} shrink-0`}>wait →</span>
        <span class={`${pip} bg-muted-foreground`}></span>
        <code class={code}>ConnectionEstablished</code>
      </li>
      <li class={`${event} group-data-motion:animate-event-second`}>
        <span class={`${mono} shrink-0`}>wait →</span>
        <span class={`${pip} bg-accent`}></span>
        <code class={code}>Nat(PathUpgraded)</code>
      </li>
      <li class={`${event} border-accent group-data-motion:animate-event-third`}>
        <span class={`${mono} shrink-0`}>wait →</span>
        <span class={`${pip} bg-accent`}></span>
        <code class={code}>ConnectSettled</code>
      </li>
    </ol>
  </div>

  <figcaption class={`mt-4 ${mono}`}>
    One ordered stream: each call returns the next event, never a batch. One
    possible order &mdash; a path can still upgrade after the attempt settles.
  </figcaption>
</figure>

<script>
  const THRESHOLD = 0.4;

  for (const figure of document.querySelectorAll<HTMLElement>("[data-stream]")) {
    // Scripts run, so the stream may animate rather than stand finished.
    figure.dataset.motion = "";

    const play = () => {
      figure.dataset.play = "";
    };

    if (typeof IntersectionObserver === "undefined") {
      play();
      continue;
    }

    const seen = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          // Same as the attempt diagram: wait for the share the threshold asks
          // for, unless the figure is too tall for that share to be reachable.
          const readable =
            entry.intersectionRatio >= THRESHOLD ||
            entry.intersectionRect.height >= window.innerHeight * 0.6;
          if (entry.isIntersecting && readable) {
            play();
            observer.disconnect();
          }
        }
      },
      { threshold: [0, THRESHOLD] }
    );
    seen.observe(figure);
  }
</script>
