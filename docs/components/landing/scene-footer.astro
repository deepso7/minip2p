---
// A scene's footer, under its stage: the numbered story and its playback.
// Without scene.ts it lists every step and has no controls. Once the scene
// plays, the steps share one grid cell and only the playing one shows, so the
// footer keeps the longest step's height and nothing below it jumps (idle
// steps are only transparent, so screen readers still reach the whole story),
// beside a play/pause/replay toggle and one progress segment per step.
interface Step {
  title: string;
  /** Plain text; `backticked` spans render as code. */
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;

// "a `b` c" → ["a ", "b", " c"]: every odd segment was inside backticks.
const segments = (text: string) => text.split("`");
const live = "group-data-scene-live/scene:col-start-1 group-data-scene-live/scene:row-start-1";
const icon = "size-3.5 fill-current";
// `m-0!`, not `m-0`: Blume's unlayered `.prose :where(p, ul, ol)` margins
// beat utilities, even inside `not-prose`.
---

<div class="mt-5 border-t border-border pt-4">
  <div class="flex items-start gap-3">
    <button
      type="button"
      class="hidden size-8 shrink-0 cursor-pointer place-items-center rounded-full border border-border bg-transparent text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-accent group-data-scene-live/scene:grid"
      aria-label="Play"
      data-toggle
    >
      {/* Pause while playing, replay once ended, play otherwise. */}
      <svg class={`${icon} hidden group-data-playing/scene:block`} viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
      </svg>
      <svg
        class="hidden size-3.5 fill-none stroke-current stroke-[2.5] group-data-ended/scene:block"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
      </svg>
      <svg
        class={`${icon} translate-x-px group-data-ended/scene:hidden group-data-playing/scene:hidden`}
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M7 4.5v15L19 12Z" />
      </svg>
    </button>
    <div class="grid flex-1 gap-2 text-sm leading-6">
      {
        steps.map((step, index) => (
          <p class={`${live} m-0!`} data-show={index + 1} data-hide={index + 2}>
            <span class="me-2 font-mono text-xs text-accent">{String(index + 1).padStart(2, "0")}</span>
            <span class="font-medium text-foreground">{segments(step.title).map((segment, i) => (i % 2 === 1 ? <code>{segment}</code> : segment))}.</span>{" "}
            <span class="text-muted-foreground">{segments(step.body).map((segment, i) => (i % 2 === 1 ? <code>{segment}</code> : segment))}</span>
          </p>
        ))
      }
    </div>
  </div>
  <div class="mt-2 hidden gap-1.5 ps-11 group-data-scene-live/scene:flex">
    {
      steps.map((_, index) => (
        <button
          type="button"
          class="group/seg flex-1 cursor-pointer border-0 bg-transparent py-2 focus-visible:outline-2 focus-visible:outline-accent"
          aria-label={`Step ${index + 1}`}
          data-goto={index + 1}
        >
          <span class="block h-0.5 overflow-hidden rounded-full bg-border">
            <span class="block h-full origin-left scale-x-0 bg-accent group-data-[state=current]/seg:animate-fill group-data-[state=done]/seg:scale-x-100 group-data-ended/scene:scale-x-100" />
          </span>
        </button>
      ))
    }
  </div>
</div>

<script>
  import { initScene } from "./scene";

  // Blume's client router swaps pages without rerunning this module, so set
  // up scenes on every page load, skipping any already live.
  document.addEventListener("astro:page-load", () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-scene]:not([data-scene-live])")) {
      initScene(root);
    }
  });
</script>
