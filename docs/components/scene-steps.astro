---
// The numbered story of a scene. As a list beside the stage, each step is a
// button that jumps the scene there and lights up while its step plays (see
// scene.ts). As a `caption`, it shows only the playing step inside the
// figure, for narrow screens where the list would sit far above the stage.
interface Step {
  title: string;
  /** Plain text; `backticked` spans render as code. */
  body: string;
}

interface Props {
  steps: Step[];
  caption?: boolean;
}

const { steps, caption = false } = Astro.props;

// "a `b` c" → ["a ", "b", " c"]: every odd segment was inside backticks.
const segments = (text: string) => text.split("`");
const chip = "grid size-5 shrink-0 place-items-center rounded-sm border font-mono text-xs";
---

{
  caption ? (
    // Every step shares one grid cell, so the caption keeps the height of the
    // longest step and nothing below it jumps as steps change. Idle steps are
    // only transparent, so screen readers still reach the whole story here
    // while the list is hidden.
    <div class="mt-6 hidden rounded-blume border border-border bg-muted px-3 py-2.5 group-data-scene-live/scene:max-lg:grid">
      {steps.map((step, index) => (
        <p class="col-start-1 row-start-1 m-0 flex gap-3" data-show={index + 1} data-hide={index + 2}>
          <span class={`${chip} mt-0.5 border-accent bg-accent text-accent-foreground`}>{index + 1}</span>
          <span class="grid gap-1">
            <span class="text-sm font-medium">
              {segments(step.title).map((segment, i) => (i % 2 === 1 ? <code class="font-mono">{segment}</code> : segment))}
            </span>
            <span class="text-sm leading-relaxed text-muted-foreground">
              {segments(step.body).map((segment, i) =>
                i % 2 === 1 ? <code class="font-mono text-foreground">{segment}</code> : segment
              )}
            </span>
          </span>
        </p>
      ))}
    </div>
  ) : (
    <ol class="m-0 grid list-none gap-1 p-0">
      {steps.map((step, index) => (
        <li>
          <button
            type="button"
            class="group/step flex w-full cursor-pointer gap-3 rounded-blume border border-transparent bg-transparent px-3 py-2.5 text-left text-muted-foreground transition-colors hover:bg-muted data-[state=current]:border-border data-[state=current]:bg-muted focus-visible:outline-2 focus-visible:outline-accent"
            data-goto={index + 1}
          >
            <span
              class={`${chip} mt-0.5 border-border transition-colors group-data-[state=current]/step:border-accent group-data-[state=current]/step:bg-accent group-data-[state=current]/step:text-accent-foreground group-data-[state=done]/step:text-foreground`}
            >
              {index + 1}
            </span>
            <span class="grid gap-1">
              <span class="text-sm font-medium text-foreground">
                {segments(step.title).map((segment, i) => (i % 2 === 1 ? <code class="font-mono">{segment}</code> : segment))}
              </span>
              <span class="text-sm leading-relaxed">
                {segments(step.body).map((segment, i) =>
                  i % 2 === 1 ? <code class="font-mono text-foreground">{segment}</code> : segment
                )}
              </span>
            </span>
          </button>
        </li>
      ))}
    </ol>
  )
}
