---
// The Docs / Changelog tabs (`navigation.tabs`) as plain text links: the
// current tab in the foreground, the others faint. Rendered at the top of the
// content column by breadcrumbs.astro, and in the header's top row on the
// changelog index, which has no content-column chrome of its own.
import data from "blume:data";
import { withMountedBase } from "blume/components/islands/base-path.ts";
import { currentTabForRoute } from "blume/components/layout/nav-utils.ts";
import { EN_UI } from "blume/core/i18n-ui.ts";

interface Props {
  route: string;
  class?: string;
}

const { route, class: className } = Astro.props;
const { tabs, root } = data.navigation;
const active = currentTabForRoute(tabs, route, root);
---

{
  tabs.length > 0 && (
    <nav aria-label={EN_UI.nav.sections} class:list={["flex gap-6 text-sm", className]}>
      {tabs.map((tab) => (
        <a
          aria-current={tab === active ? "page" : undefined}
          class="text-faint transition-colors hover:text-foreground aria-[current=page]:text-foreground"
          href={withMountedBase(tab.href ?? tab.path)}
        >
          {tab.label}
        </a>
      ))}
    </nav>
  )
}
