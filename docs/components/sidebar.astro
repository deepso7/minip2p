---
// The `Sidebar` layout slot (and so the mobile drawer's nav too): Blume's nav
// tree, unchanged, then a foot with the repository link and the release
// version. theme.css styles the tree itself.
import type { ComponentProps } from "astro/types";
import NavTree from "blume/components/layout/NavTree.astro";
import { newTabAttrs } from "blume/core/new-tab.ts";
import { version } from "./workspace";

type Props = ComponentProps<typeof NavTree>;

const repository = "https://github.com/deepso7/minip2p";
---

<NavTree {...Astro.props} />
<div class="mt-8 flex items-center justify-between text-faint text-xs">
  <a class="transition-colors hover:text-foreground" href={repository} {...newTabAttrs(repository)}>
    GitHub ↗
  </a>
  <span class="font-mono">v{version}</span>
</div>
