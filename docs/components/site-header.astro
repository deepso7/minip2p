---
// The `Header` layout slot, rendered by every RootLayout page (docs pages,
// changelog entries, and the changelog index). Landing and 404 pages use
// Blume's PageLayout, which always renders its built-in header; theme.css
// restyles that one to match the top row below.
//
// - Docs pages, `lg` and up: no header bar. This element is fixed over the top
//   of the sidebar column (`--minip2p-shell-pin` tall): the logo and theme
//   toggle, then a field-style search trigger. The sidebar below starts at the
//   same offset (theme.css), so only the nav list scrolls.
// - Below `lg`: a borderless top bar of menu toggle, logo, search, and theme
//   toggle. The drawer's top offset is measured from it, as Blume's is.
// - The changelog index (no sidebar): the same top bar at every width, with the
//   section tabs after the logo.
import type { ComponentProps } from "astro/types";
import data from "blume:data";
import Icon from "blume/components/Icon.astro";
import type BlumeHeader from "blume/components/layout/Header.astro";
import Logo from "blume/components/layout/Logo.astro";
import Search from "blume/components/layout/Search.astro";
import { EN_UI } from "blume/core/i18n-ui.ts";
import SectionTabs from "./section-tabs.astro";
import { isBareRoute } from "./shell";

type Props = ComponentProps<typeof BlumeHeader>;

const {
  assistantEnabled = Boolean(data.config.assistant),
  locale,
  logo,
  navStrings,
  navigation,
  route,
  searchEnabled,
  searchLocale,
  searchStrings,
  searchVersion = null,
  site,
} = Astro.props;

const n = { ...EN_UI.nav, ...navStrings };
const bare = isBareRoute(route);
const iconButton =
  "inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-foreground";

// Blume's header script, copied verbatim from its Header.astro (which keeps it
// in frontmatter, so it can't be imported): delegated clicks for the theme
// toggle (transitions suppressed for the swap, choice saved to storage), the
// drawer toggle (measuring this header's bottom into `--blume-drawer-top`),
// and banner dismissal, plus closing the drawer when the window widens past
// `lg`. Re-copy it when upgrading Blume.
const clickScript = `(()=>{const dr=()=>{const h=document.querySelector("[data-blume-header]");if(h){document.documentElement.style.setProperty("--blume-drawer-top",h.getBoundingClientRect().bottom+"px");}};const save=(k,v)=>{try{localStorage.setItem(k,v);}catch{}};document.addEventListener("click",(e)=>{const t=e.target.closest("[data-blume-theme-toggle]");if(t){const d=document.documentElement;const next=d.dataset.theme==="dark"?"light":"dark";const s=document.createElement("style");s.appendChild(document.createTextNode("*,*::before,*::after{transition:none!important}"));document.head.appendChild(s);d.dataset.theme=next;window.getComputedStyle(d).opacity;setTimeout(()=>document.head.removeChild(s),1);save("blume-theme",next);}const n=e.target.closest("[data-blume-nav-toggle]");if(n){const d=document.documentElement;const open=d.toggleAttribute("data-blume-nav-open");if(open){dr();}}const b=e.target.closest("[data-blume-banner-dismiss]");if(b){document.documentElement.setAttribute("data-blume-banner-hidden","");requestAnimationFrame(dr);const bar=b.closest("[data-blume-banner]");const k=bar&&bar.getAttribute("data-banner-key");if(k){save("blume-banner:"+k,"1");}}});addEventListener("resize",()=>{const d=document.documentElement;if(!d.hasAttribute("data-blume-nav-open")){return;}if(matchMedia("(min-width:64rem)").matches){d.removeAttribute("data-blume-nav-open");}else{dr();}});})();`;
---

<header
  class:list={[
    "sticky top-0 z-40 flex h-14 items-center gap-2 bg-background px-4 md:px-6",
    bare
      ? "lg:px-8"
      : "lg:fixed lg:start-0 lg:grid lg:h-(--minip2p-shell-pin) lg:w-[17.5rem] lg:grid-cols-[minmax(0,1fr)_auto] lg:content-start lg:gap-x-2 lg:gap-y-4 lg:px-6 lg:pt-6",
  ]}
  data-blume-header
  data-site-header={bare ? "bar" : "pinned"}
>
  <button
    aria-controls="blume-nav-drawer"
    aria-expanded="false"
    aria-label={n.toggleNavigation}
    class={`${iconButton} -ms-2 lg:hidden`}
    data-blume-nav-toggle
    type="button"
  >
    <Icon name="menu" size={20} />
  </button>
  <div class="flex min-w-0 items-center lg:col-start-1 lg:row-start-1">
    <Logo locale={locale} logo={logo} site={site} />
  </div>
  {bare && <SectionTabs class="ms-6 hidden md:flex" route={route} />}
  <div class:list={["flex-1", !bare && "lg:hidden"]}></div>
  {
    searchEnabled && (
      <div
        class:list={[
          "relative flex items-center",
          !bare &&
            "lg:col-span-2 lg:row-start-2 lg:h-8 lg:justify-between lg:rounded-lg lg:border lg:border-border lg:px-3 lg:text-faint lg:text-sm lg:transition-colors lg:hover:border-faint lg:hover:text-muted-foreground",
        ]}
        data-site-search={bare ? "icon" : "field"}
      >
        {!bare && <span aria-hidden="true" class="hidden lg:inline">Search</span>}
        {!bare && <kbd aria-hidden="true" class="hidden font-mono text-xs lg:inline">⌘K</kbd>}
        <Search
          assistantEnabled={assistantEnabled}
          locale={searchLocale}
          navigation={navigation}
          popularPages={data.config.search.popular}
          strings={searchStrings}
          version={searchVersion}
        />
      </div>
    )
  }
  {
    data.config.theme.toggle && (
      <button
        aria-label={n.toggleTheme}
        class:list={[
          iconButton,
          "-me-2",
          !bare && "lg:col-start-2 lg:row-start-1 lg:me-0 lg:size-8",
        ]}
        data-blume-theme-toggle
        type="button"
      >
        <span class="inline-flex dark:hidden"><Icon name="sun" size={16} /></span>
        <span class="hidden dark:inline-flex"><Icon name="moon" size={16} /></span>
      </button>
    )
  }
</header>
<script is:inline set:html={clickScript} />
