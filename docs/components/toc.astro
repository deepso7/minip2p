---
// The `TableOfContents` layout slot. The right rail's list (`desktop`) is
// quiet: a faint mono eyebrow, faint links, the current heading in the
// foreground. The "On this page" dropdown above the content below `xl`
// (`mobile`, which also receives the page actions as children) stays Blume's.
// `<blume-toc>` is Blume's element; it marks the current heading.
import type { ComponentProps } from "astro/types";
import BlumeToc from "blume/components/layout/TableOfContents.astro";

type Props = ComponentProps<typeof BlumeToc>;

const { headings, title, variant } = Astro.props;
---

{
  variant === "mobile" ? (
    <BlumeToc {...Astro.props}>
      <slot />
    </BlumeToc>
  ) : (
    headings.length > 0 && (
      <>
        <p class="mb-3 font-mono text-faint text-xs lowercase">{title}</p>
        <blume-toc class="block">
          <ul class="m-0 list-none p-0">
            {headings.map((heading) => (
              <li class:list={[heading.depth > 2 && "ps-3"]} data-depth={heading.depth}>
                <a
                  class="block py-1 text-faint text-sm transition-colors hover:text-foreground aria-[current=location]:text-foreground"
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </blume-toc>
      </>
    )
  )
}
