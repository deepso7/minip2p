---
import data from "blume:data";
import Tab from "blume/components/content/Tab.astro";
import Tabs from "blume/components/content/Tabs.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import { highlightCode } from "blume/markdown";
import Mascot from "../components/mascot.astro";
import ConnectionAttempt from "../components/connection-attempt.astro";
import SansIoLoop from "../components/sans-io-loop.astro";
// Both snippets are read verbatim from files CI checks, so the landing page
// shows code that compiles: the Rust dialer (`cargo check` in the docs job)
// and the Node example (`tsc` in the bindings job's `pnpm typecheck`).
import dialer from "../snippets/quickstart/src/bin/dialer.rs?raw";
// oxlint-disable-next-line import/default -- Vite's `?raw` adds the default export; the linter resolves the bare `.ts`.
import ping from "../../examples/nodejs/ping.ts?raw";

const { config, navigation, fontCssVars } = data;

// Highlighted here rather than through <CodeBlock>, which wraps each block in
// its own div: a <Tab> holding a bare <pre> is a code panel, so it renders
// flush in the tab box exactly like a CodeGroup in the docs.
const highlight = (code: string, lang: string) =>
  highlightCode(code.trimEnd(), lang, { themes: config.codeThemes });
const [dialerHtml, pingHtml] = await Promise.all([
  highlight(dialer, "rust"),
  highlight(ping, "ts"),
]);

const platforms = [
  {
    body: "QUIC over quiche with libp2p TLS certificates, and TCP upgraded with Noise XX and Yamux. One transport set routes each address to the transport that serves its shape.",
    label: "Transports",
    title: "QUIC and TCP",
  },
  {
    body: "The core crates build for thumbv7em with no operating system. TCP runs over smoltcp, and mDNS discovery comes with it.",
    label: "Embedded",
    title: "no_std + alloc",
  },
  {
    body: "One binding-agnostic FFI core, wrapped by napi-rs for Node and UniFFI for React Native, under a shared TypeScript SDK.",
    label: "Bindings",
    title: "Node and React Native",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  navigation={navigation}
  themeMode={config.theme.mode}
  fontCssVars={fontCssVars}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  x={config.x}
  page={{
    title: "minip2p · Minimal peer-to-peer networking",
    description:
      "A minimal libp2p implementation in Rust. Connect applications over QUIC and TCP from Rust, Node.js, or React Native.",
    route: "/",
  }}
>
  <div
    class="mx-auto -mt-16 flex min-h-dvh max-w-7xl flex-col px-6 pt-16 lg:px-8"
  >
    <p
      class="m-0 shrink-0 pt-3 text-center sm:pt-4 font-mono text-xs text-muted-foreground lg:pt-8 landscape:max-lg:pt-2"
    >
      A minimal libp2p implementation
    </p>
    <section
      class="grid flex-1 grid-cols-1 content-evenly items-center gap-2 py-3 text-center sm:gap-4 sm:py-4 lg:grid-cols-3 lg:gap-8 lg:py-8 lg:text-left landscape:max-lg:grid-cols-2 landscape:max-lg:gap-2 landscape:max-lg:py-2"
      aria-labelledby="hero-title"
    >
      <div>
        <h1
          class="m-0 text-3xl font-medium leading-tight tracking-tighter sm:text-4xl xl:text-5xl landscape:max-lg:text-3xl"
          id="hero-title"
        >
          Peer-to-peer.<br />Keep it simple.
        </h1>
        <p
          class="mx-auto my-3 max-w-xs text-sm leading-relaxed text-muted-foreground lg:mx-0 lg:my-6 lg:text-base landscape:max-lg:my-2"
        >
          Connect applications over authenticated QUIC and TCP.
        </p>
        <div
          class="mx-auto grid w-48 gap-3 sm:flex sm:w-auto sm:flex-wrap sm:justify-center lg:mx-0 lg:justify-start"
        >
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full border border-transparent bg-foreground px-3 py-3 text-sm font-medium text-background no-underline hover:bg-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:px-4 landscape:max-lg:py-2"
            href="/intro">Read the docs <span aria-hidden="true">↗</span></a
          >
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full border border-border px-3 py-3 text-sm font-medium text-foreground no-underline hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:px-4 landscape:max-lg:py-2"
            href="https://github.com/deepso7/minip2p"
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <div
        class="relative isolate order-first w-28 select-none justify-self-center sm:w-48 lg:order-none lg:w-full landscape:max-lg:order-none landscape:max-lg:w-36"
      >
        <div
          class="pointer-events-none absolute inset-0 -z-10 scale-150 rounded-full bg-accent/15 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <Mascot
          directions="/mascots/logo-directions.svg"
          reactions="/mascots/logo-reactions.svg"
          aspect={840 / 700}
          label="minip2p dinosaur"
        />
      </div>
      <nav
        class="flex flex-wrap justify-center gap-x-4 gap-y-2 lg:grid lg:justify-self-end lg:gap-7 landscape:max-lg:col-span-full"
        aria-label="Get started by platform"
      >
        <a
          class="group grid gap-1.5 py-1.5 text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          href="/rust/install"
        >
          <span
            class="text-xs font-medium underline-offset-4 group-hover:underline lg:text-sm"
            >Rust</span
          >
          <small class="hidden text-sm text-muted-foreground lg:block"
            >Drive your own event loop.</small
          >
        </a>
        <a
          class="group grid gap-1.5 py-1.5 text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          href="/typescript/start"
        >
          <span
            class="text-xs font-medium underline-offset-4 group-hover:underline lg:text-sm"
            >Node.js &amp; React Native</span
          >
          <small class="hidden text-sm text-muted-foreground lg:block"
            >Promises and typed events.</small
          >
        </a>
        <a
          class="group grid gap-1.5 py-1.5 text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          href="/rust/embedded-devices"
        >
          <span
            class="text-xs font-medium underline-offset-4 group-hover:underline lg:text-sm"
            >Embedded Rust</span
          >
          <small class="hidden text-sm text-muted-foreground lg:block"
            >A portable no_std + alloc core.</small
          >
        </a>
      </nav>
    </section>
    <p class="shrink-0 pb-3 text-center sm:pb-4 landscape:max-lg:pb-2">
      <a
        class="font-mono text-xs text-muted-foreground no-underline hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        href="#how-it-works">How it works <span aria-hidden="true">↓</span></a
      >
    </p>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <section
      class="border-t border-border py-16 sm:py-20"
      id="how-it-works"
      aria-labelledby="attempt-title"
    >
      <ConnectionAttempt>
        <p class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground">Connection attempt</p>
        <h2 class="mt-4 mb-0 text-2xl font-medium leading-tight tracking-tighter sm:text-3xl" id="attempt-title">Many routes.<br />One outcome.</h2>
        <p class="mt-4 mb-0 text-sm leading-relaxed text-muted-foreground sm:text-base">
          Call <code class="font-mono text-foreground">connect</code> once. Every
          route races inside one attempt, and your loop hears how it ends exactly
          once.
        </p>
        <a class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href="/rust/traverse-nat" slot="more"
          >Traverse NAT <span aria-hidden="true">↗</span></a
        >
      </ConnectionAttempt>
    </section>

    <section
      class="border-t border-border py-16 sm:py-20"
      aria-labelledby="loop-title"
    >
      <SansIoLoop>
        <p class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground">Sans-I/O</p>
        <h2 class="mt-4 mb-0 text-2xl font-medium leading-tight tracking-tighter sm:text-3xl" id="loop-title">You drive<br />the loop.</h2>
        <p class="mt-4 mb-0 text-sm leading-relaxed text-muted-foreground sm:text-base">
          Nothing runs behind your back. Sockets, clocks and timers live in
          adapters; the protocols are deterministic state machines that only move
          when you call <code class="font-mono text-foreground">wait</code>.
        </p>
        <a class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href="/rust/drive-events" slot="more"
          >Drive events <span aria-hidden="true">↗</span></a
        >
      </SansIoLoop>
    </section>

    <section
      class="border-t border-border py-16 sm:py-20"
      aria-labelledby="platforms-title"
    >
      <p
        class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground"
      >
        Same core everywhere
      </p>
      <h2
        class="mt-4 mb-0 max-w-xl text-2xl font-medium leading-tight tracking-tighter sm:text-3xl"
        id="platforms-title"
      >
        From a server to a microcontroller.
      </h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          platforms.map((platform) => (
            <div class="rounded-blume border border-border p-6">
              <p class="m-0 font-mono text-xs uppercase tracking-wide text-accent">
                {platform.label}
              </p>
              <p class="mt-3 mb-0 text-lg font-medium">{platform.title}</p>
              <p class="mt-2 mb-0 text-sm leading-relaxed text-muted-foreground">
                {platform.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="border-t border-border py-16 sm:py-20"
      aria-labelledby="start-title"
    >
      <p
        class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground"
      >
        Quickstart
      </p>
      <h2
        class="mt-4 mb-0 text-2xl font-medium leading-tight tracking-tighter sm:text-3xl"
        id="start-title"
      >
        Connect, then drive.
      </h2>
      <p
        class="mt-4 mb-0 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base"
      >
        Add <code class="font-mono text-foreground">minip2p-rs</code> or{" "}
        <code class="font-mono text-foreground">@minip2p/node</code>, then dial
        a peer, wait until it is ready, and ping it. Both snippets are shown
        verbatim from the repository, and CI compiles both: the Rust dialer and
        the TypeScript example you can run with Node.
      </p>
      {/* `.prose` gives the tabs the same code styles as a docs page. */}
      <div class="prose mt-8 max-w-none" data-quickstart>
        <Tabs hash={false}>
          <Tab title="Rust"><Fragment set:html={dialerHtml} /></Tab>
          <Tab title="TypeScript"><Fragment set:html={pingHtml} /></Tab>
        </Tabs>
        {/* Blume builds the tab buttons from script and, until then, shows only
            the first panel. Without scripts, show both snippets instead, each
            labelled from the title Blume already puts on its panel. */}
        <noscript>
          <style>
            [data-quickstart] [data-blume-tablist] {
              display: none;
            }
            [data-quickstart] [data-blume-tab-content] > * {
              display: block !important;
            }
            [data-quickstart] [data-blume-tab-panel]::before {
              border-bottom: 1px solid var(--blume-border);
              color: var(--blume-muted-foreground);
              content: attr(data-title);
              display: block;
              font-family: var(--blume-font-mono);
              font-size: 0.75rem;
              padding: 0.625rem 1rem;
            }
          </style>
        </noscript>
      </div>
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          href="/rust/install"
          >Rust quickstart <span aria-hidden="true">↗</span></a
        >
        <a
          class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          href="/typescript/start"
          >TypeScript quickstart <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
  </div>

  <footer
    class="mx-auto max-w-7xl shrink-0 px-6 py-6 text-center text-xs text-muted-foreground lg:px-8"
  >
    Made with <svg
      class="inline-block size-3.5 fill-accent align-middle"
      viewBox="0 0 24 24"
      role="img"
      aria-label="love"
      ><path
        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"
      ></path></svg
    > by <a
      class="text-foreground no-underline underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      href="https://deepso.sh"
      target="_blank"
      rel="noopener noreferrer">deepso</a
    >
  </footer>
</PageLayout>
