---
import data from "blume:data";
import Tab from "blume/components/content/Tab.astro";
import Tabs from "blume/components/content/Tabs.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import { highlightCode } from "blume/markdown";
import Mascot from "../components/mascot.astro";
import StatusBar from "../components/status-bar.astro";
// Both snippets are read verbatim from files CI checks, so the landing page
// shows code that compiles: the Rust dialer (`cargo check` in the docs job)
// and the Node example (`tsc` in the bindings job's `pnpm typecheck`).
import dialer from "../snippets/quickstart/src/bin/dialer.rs?raw";
// oxlint-disable-next-line import/default -- Vite's `?raw` adds the default export; the linter resolves the bare `.ts`.
import ping from "../../examples/nodejs/ping.ts?raw";
import { rustVersion as msrv, version } from "../components/workspace";

const { config, navigation, fontCssVars } = data;

// Highlighted here rather than through <CodeBlock>, which wraps each block in
// its own div: a <Tab> holding a bare <pre> is a code panel, so it renders
// flush in the tab box exactly like a CodeGroup in the docs.
const highlight = (code: string, lang: string) =>
  highlightCode(code.trimEnd(), lang, { themes: config.codeThemes });
const [dialerHtml, pingHtml] = await Promise.all([
  highlight(dialer, "rust"),
  highlight(ping, "ts"),
]);

// The landing page is the project's man page: the sections a reader of
// `man minip2p` expects, in the order they expect them.
const install = [
  { command: "cargo add minip2p-rs", note: "Rust" },
  { command: "npm install @minip2p/node", note: "Node.js" },
  { command: "npm install @minip2p/react-native", note: "React Native" },
  { command: "npm install @minip2p/web", note: "browser" },
];

// Cargo features of `minip2p-rs`, as `crates/minip2p/Cargo.toml` names them.
const features = [
  { body: "QUIC over quinn-proto with libp2p TLS. On by default; needs std.", name: "quic" },
  { body: "TCP upgraded with Noise XX and Yamux, beside or instead of QUIC.", name: "tcp" },
  { body: "AutoNAT probes, relayed connections, and DCUtR hole punching.", name: "nat" },
  { body: "Signed gossipsub publish and subscribe.", name: "pubsub" },
  { body: "Signed beacons, a shared peer book, and optional auto-dial.", name: "discovery" },
  { body: "Local-link discovery over multicast DNS.", name: "mdns" },
  { body: "Host a Circuit Relay v2 server.", name: "relay-server" },
  { body: "TCP and mDNS over a host-owned smoltcp stack, for no_std devices.", name: "smoltcp" },
];

const seeAlso = [
  { body: "Install, connect two peers, drive the event loop.", href: "/docs/rust/install", name: "minip2p-rust", section: 7 },
  { body: "Node.js, React Native, and the browser.", href: "/docs/typescript/start", name: "minip2p-typescript", section: 7 },
  { body: "The portable no_std + alloc endpoint.", href: "/docs/rust/embedded-devices", name: "minip2p-embedded", section: 7 },
  { body: "Relays, AutoNAT, and hole punching.", href: "/docs/rust/traverse-nat", name: "minip2p-nat", section: 7 },
  { body: "Every capability and what it needs.", href: "/docs/reference/feature-matrix", name: "minip2p-features", section: 5 },
  { body: "What changed in each release.", href: "/changelog", name: "minip2p-changelog", section: 1 },
  { body: "The Rust API reference.", href: "https://docs.rs/minip2p-rs/latest/minip2p/", name: "docs.rs", section: 3 },
];

const heading = "m-0 text-sm font-bold tracking-wide text-foreground";
// The man-page indent, in rem so the larger NAME line lines up with the rest.
const body = "mt-3 ps-5 sm:ps-14";
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  navigation={navigation}
  themeMode={config.theme.mode}
  fontCssVars={fontCssVars}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  x={config.x}
  page={{
    title: "minip2p · Minimal peer-to-peer networking",
    description:
      "A minimal libp2p implementation in Rust. Connect applications over QUIC and TCP from Rust, Node.js, or React Native.",
    route: "/",
  }}
>
  <article class="man mx-auto max-w-4xl px-6 pt-8 pb-20 font-mono text-sm leading-relaxed sm:pt-12 lg:px-8">
    <p class="man-running m-0 flex justify-between sm:grid sm:grid-cols-[1fr_auto_1fr] gap-4 text-xs text-muted-foreground" aria-hidden="true">
      <span>MINIP2P(7)</span>
      <span class="hidden sm:inline">Peer-to-Peer Networking Manual</span>
      <span class="text-end">MINIP2P(7)</span>
    </p>

    {/* NAME and SYNOPSIS share the first screen with the mascot, at the size
        it had on the old hero; it still watches the pointer and reacts when
        booped. */}
    <div class="mt-10 grid items-center gap-x-10 gap-y-8 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <figure class="m-0 justify-self-center lg:order-last lg:justify-self-end">
        <div class="w-44 select-none sm:w-56 lg:w-64">
          <Mascot
            directions="/mascots/logo-directions.svg"
            reactions="/mascots/logo-reactions.svg"
            aspect={840 / 700}
            label="minip2p dinosaur"
          />
        </div>
        <figcaption class="mt-3 text-center text-xs text-muted-foreground">
          fig. 1 — the dino. <span class="text-accent">boop it.</span>
        </figcaption>
      </figure>

      <div>
        <section aria-labelledby="man-name">
          <h2 class={heading} id="man-name">NAME</h2>
          <h1 class={`${body} mb-0 text-[clamp(1.25rem,2.6vw,1.875rem)] leading-tight font-normal text-foreground`}>
            <b class="font-bold">minip2p</b> <span class="text-muted-foreground">—</span>{" "}
            <span class="whitespace-nowrap">peer-to-peer,</span> <span class="whitespace-nowrap text-accent">kept simple.</span>
          </h1>
        </section>

        <section class="mt-10" aria-labelledby="man-synopsis">
          <h2 class={heading} id="man-synopsis">SYNOPSIS</h2>
          <ul class={`${body} m-0 list-none p-0`}>
            {
              install.map(({ command, note }) => (
                <li class="man-command group flex items-center gap-3 py-1">
                  <span class="text-muted-foreground" aria-hidden="true">$</span>
                  <code class="text-foreground">{command}</code>
                  <span class="hidden text-muted-foreground sm:inline"># {note}</span>
                  <button
                    type="button"
                    class="man-copy ms-auto text-xs text-muted-foreground hover:text-accent focus-visible:text-accent"
                    data-copy={command}
                    aria-label={`Copy ${command}`}
                    hidden
                  >
                    copy
                  </button>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <section class="mt-10" aria-labelledby="man-description">
      <h2 class={heading} id="man-description">DESCRIPTION</h2>
      <div class={`${body} flex max-w-[72ch] flex-col gap-4 text-muted-foreground`}>
        <p class="m-0">
          <b class="text-foreground">minip2p</b> is a minimal libp2p implementation
          in Rust. It connects applications over authenticated QUIC and TCP,
          negotiates custom protocol streams, and adds pubsub, discovery, relays,
          and NAT traversal only when you ask for them.
        </p>
        <p class="m-0">
          Nothing runs behind your back. There is no async runtime: the protocols
          are deterministic sans-I/O state machines that move only when you call{" "}
          <b class="text-foreground">wait</b>. Sockets, clocks, and timers live in
          adapters, and{" "}
          <span class="underline decoration-accent underline-offset-4">unsafe</span>{" "}
          is forbidden across the workspace.
        </p>
        <p class="m-0">
          The core builds as <b class="text-foreground">no_std + alloc</b> for
          microcontrollers. Node.js, React Native, and the browser drive the same
          endpoint through bindings, with Promises and typed events.
        </p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="man-features">
      <h2 class={heading} id="man-features">FEATURES</h2>
      <p class={`${body} m-0 text-muted-foreground`}>
        Cargo features of <b class="text-foreground">minip2p-rs</b>. Each adds a
        capability without changing the endpoint interface.
      </p>
      <dl class={`${body} m-0`}>
        {
          features.map(({ name, body: text }) => (
            <div class="grid gap-x-6 py-1.5 sm:grid-cols-[16ch_1fr]">
              <dt class="font-bold text-accent">{name}</dt>
              <dd class="m-0 ps-[4ch] text-muted-foreground sm:ps-0">{text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-10" aria-labelledby="man-examples">
      <h2 class={heading} id="man-examples">EXAMPLES</h2>
      <p class={`${body} m-0 text-muted-foreground`}>
        Dial a peer, wait until it is ready, and ping it. Both programs are
        compiled in CI exactly as shown.
      </p>
      {/* `.prose` gives the tabs the same code styles as a docs page. */}
      <div class={`${body} prose man-example max-w-none`} data-quickstart>
        <Tabs hash={false}>
          <Tab title="Rust"><Fragment set:html={dialerHtml} /></Tab>
          <Tab title="TypeScript"><Fragment set:html={pingHtml} /></Tab>
        </Tabs>
        {/* Blume builds the tab buttons from script and, until then, shows only
            the first panel. Without scripts, show both snippets instead, each
            labelled from the title Blume already puts on its panel. */}
        <noscript>
          <style>
            [data-quickstart] [data-blume-tablist] {
              display: none;
            }
            [data-quickstart] [data-blume-tab-content] > * {
              display: block !important;
            }
            [data-quickstart] [data-blume-tab-panel]::before {
              border-bottom: 1px solid var(--blume-border);
              color: var(--blume-muted-foreground);
              content: attr(data-title);
              display: block;
              font-family: var(--blume-font-mono);
              font-size: 0.75rem;
              padding: 0.625rem 1rem;
            }
          </style>
        </noscript>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="man-see-also">
      <h2 class={heading} id="man-see-also">SEE ALSO</h2>
      <ul class={`${body} m-0 list-none p-0`}>
        {
          seeAlso.map(({ href, name, section, body: text }) => {
            const external = href.startsWith("http");
            return (
              <li>
                <a
                  class="group grid gap-x-6 py-1.5 text-muted-foreground no-underline sm:grid-cols-[24ch_1fr]"
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  <span>
                    <b class="text-foreground underline decoration-accent/60 underline-offset-4 group-hover:text-accent group-hover:decoration-accent">{name}</b>({section})
                  </span>
                  <span class="ps-[4ch] group-hover:text-foreground sm:ps-0">{text}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <p class="man-running mt-14 mb-0 flex justify-between sm:grid sm:grid-cols-[1fr_auto_1fr] gap-4 text-xs text-muted-foreground">
      <span>minip2p {version}</span>
      <span class="hidden sm:inline">{msrv && `rust ${msrv}+`}</span>
      <span class="text-end">MINIP2P(7)</span>
    </p>
  </article>
  <StatusBar slot="footer" />
</PageLayout>

<script>
  // Copy buttons appear only where the Clipboard API does; otherwise the
  // commands stay plain, selectable text. A denied write says so on the
  // button rather than failing silently.
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.hidden = false;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.textContent = "copied";
        } catch {
          button.textContent = "select it";
        }
        setTimeout(() => (button.textContent = "copy"), 1500);
      });
    }
  }
</script>
