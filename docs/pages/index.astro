---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import Mascot from "../components/mascot.astro";
import ConnectionAttempt from "../components/connection-attempt.astro";
import EventStream from "../components/event-stream.astro";
// Both snippets are read from code that lives in the repo and is kept working —
// the Rust one is compiled by CI, the Node one is the example package — so the
// landing page cannot drift from code that runs.
import dialer from "../snippets/quickstart/src/bin/dialer.rs?raw";
// The Node example arrives through a glob rather than a plain `?raw` import:
// same build-time inline, but the linter resolves `.mjs` and would look for a
// default export that Vite's `?raw` only adds at build time.
const [ping] = Object.values(
  import.meta.glob<string>("../../examples/nodejs/ping.mjs", {
    eager: true,
    import: "default",
    query: "?raw",
  })
);

const { config, navigation, fontCssVars } = data;

const platforms = [
  {
    body:
      "QUIC over quiche with libp2p TLS certificates, and TCP upgraded with Noise XX and Yamux. One transport set routes each address to the transport that serves its shape.",
    label: "Transports",
    title: "QUIC and TCP",
  },
  {
    body:
      "The core crates build for thumbv7em with no operating system. TCP runs over smoltcp, and mDNS discovery comes with it.",
    label: "Embedded",
    title: "no_std + alloc",
  },
  {
    body:
      "One binding-agnostic FFI core, wrapped by napi-rs for Node and UniFFI for React Native, under a shared TypeScript SDK.",
    label: "Bindings",
    title: "Node and React Native",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  navigation={navigation}
  themeMode={config.theme.mode}
  fontCssVars={fontCssVars}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  x={config.x}
  page={{
    title: "minip2p · Minimal peer-to-peer networking",
    description: "A minimal libp2p implementation in Rust. Connect applications over QUIC and TCP from Rust, Node.js, or React Native.",
    route: "/",
  }}
>
  <div class="mx-auto -mt-16 flex min-h-dvh max-w-7xl flex-col px-6 pt-16 lg:px-8">
    <p class="m-0 shrink-0 pt-3 text-center sm:pt-4 font-mono text-xs text-muted-foreground lg:pt-8 landscape:max-lg:pt-2">
      A minimal libp2p implementation
    </p>
    <section
      class="grid flex-1 grid-cols-1 content-evenly items-center gap-2 py-3 text-center sm:gap-4 sm:py-4 lg:grid-cols-3 lg:gap-8 lg:py-8 lg:text-left landscape:max-lg:grid-cols-2 landscape:max-lg:gap-2 landscape:max-lg:py-2"
      aria-labelledby="hero-title"
    >
      <div>
        <h1 class="m-0 text-3xl font-medium leading-tight tracking-tighter sm:text-4xl xl:text-5xl landscape:max-lg:text-3xl" id="hero-title">
          Peer-to-peer.<br />Keep it simple.
        </h1>
        <p class="mx-auto my-3 max-w-xs text-sm leading-relaxed text-muted-foreground lg:mx-0 lg:my-6 lg:text-base landscape:max-lg:my-2">
          Connect applications over authenticated QUIC and TCP.
        </p>
        <div class="mx-auto grid w-48 gap-3 sm:flex sm:w-auto sm:flex-wrap sm:justify-center lg:mx-0 lg:justify-start">
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full border border-transparent bg-foreground px-3 py-3 text-sm font-medium text-background no-underline hover:bg-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:px-4 landscape:max-lg:py-2"
            href="/intro"
          >Read the docs <span aria-hidden="true">↗</span></a>
          <a
            class="inline-flex items-center justify-center gap-2 rounded-full border border-border px-3 py-3 text-sm font-medium text-foreground no-underline hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:px-4 landscape:max-lg:py-2"
            href="https://github.com/deepso7/minip2p"
          >GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="relative isolate order-first w-28 select-none justify-self-center sm:w-48 lg:order-none lg:w-full landscape:max-lg:order-none landscape:max-lg:w-36">
        <div class="pointer-events-none absolute inset-0 -z-10 scale-150 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
        <Mascot
          directions="/mascots/logo-directions.svg"
          reactions="/mascots/logo-reactions.svg"
          aspect={840 / 700}
          label="minip2p dinosaur"
        />
      </div>
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2 lg:grid lg:justify-self-end lg:gap-7 landscape:max-lg:col-span-full" aria-label="Get started by platform">
        <a class="group grid gap-1.5 py-1.5 text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href="/rust/install">
          <span class="text-xs font-medium underline-offset-4 group-hover:underline lg:text-sm">Rust</span>
          <small class="hidden text-sm text-muted-foreground lg:block">Drive your own event loop.</small>
        </a>
        <a class="group grid gap-1.5 py-1.5 text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href="/typescript/start">
          <span class="text-xs font-medium underline-offset-4 group-hover:underline lg:text-sm">Node.js &amp; React Native</span>
          <small class="hidden text-sm text-muted-foreground lg:block">Promises and typed events.</small>
        </a>
        <a class="group grid gap-1.5 py-1.5 text-foreground no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href="/rust/embedded-devices">
          <span class="text-xs font-medium underline-offset-4 group-hover:underline lg:text-sm">Embedded Rust</span>
          <small class="hidden text-sm text-muted-foreground lg:block">A portable no_std + alloc core.</small>
        </a>
      </nav>
    </section>
    <p class="shrink-0 pb-3 text-center sm:pb-4 landscape:max-lg:pb-2">
      <a
        class="font-mono text-xs text-muted-foreground no-underline hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        href="#how-it-works"
      >How it works <span aria-hidden="true">↓</span></a>
    </p>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <section class="border-t border-border py-16 sm:py-20" id="how-it-works" aria-labelledby="attempt-title">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground">Connection attempt</p>
          <h2 class="mt-4 mb-0 text-2xl font-medium leading-tight tracking-tighter sm:text-3xl" id="attempt-title">
            Many routes.<br />One outcome.
          </h2>
          <p class="mt-4 mb-0 text-sm leading-relaxed text-muted-foreground sm:text-base">
            Call <code class="font-mono text-[0.9em] text-foreground">connect</code> once and you get one Connect ID back.
            Direct QUIC and TCP candidates race a relay leg that starts 200&nbsp;ms later, and a relayed circuit can carry
            traffic while DCUtR punches a direct path.
          </p>
          <p class="mt-3 mb-0 text-sm leading-relaxed text-muted-foreground sm:text-base">
            Whichever route wins, the attempt ends in exactly one{" "}
            <code class="font-mono text-[0.9em] text-foreground">ConnectSettled</code>.
          </p>
          <p class="mt-5 mb-0">
            <a
              class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
              href="/rust/traverse-nat"
            >Traverse NAT <span aria-hidden="true">↗</span></a>
          </p>
        </div>
        <ConnectionAttempt />
      </div>
    </section>

    <section class="border-t border-border py-16 sm:py-20" aria-labelledby="loop-title">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-16">
        <EventStream class="order-last lg:order-first" />
        <div>
          <p class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground">Sans-I/O</p>
          <h2 class="mt-4 mb-0 text-2xl font-medium leading-tight tracking-tighter sm:text-3xl" id="loop-title">
            You drive<br />the loop.
          </h2>
          <p class="mt-4 mb-0 text-sm leading-relaxed text-muted-foreground sm:text-base">
            Nothing runs behind your back. The protocol crates are deterministic state machines: you hand them bytes and a
            timestamp, they hand you events and a deadline. Sockets, clocks and timers live only in adapters.
          </p>
          <p class="mt-3 mb-0 text-sm leading-relaxed text-muted-foreground sm:text-base">
            Connections, streams, NAT paths, Gossipsub and discovery all leave through one ordered event stream, so a
            single{" "}<code class="font-mono text-[0.9em] text-foreground">wait</code> loop sees everything, exactly once.
          </p>
          <p class="mt-5 mb-0">
            <a
              class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
              href="/rust/drive-events"
            >Drive events <span aria-hidden="true">↗</span></a>
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-border py-16 sm:py-20" aria-labelledby="platforms-title">
      <p class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground">Same core everywhere</p>
      <h2 class="mt-4 mb-0 max-w-xl text-2xl font-medium leading-tight tracking-tighter sm:text-3xl" id="platforms-title">
        From a server to a microcontroller.
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          platforms.map((platform) => (
            <div class="rounded-xl border border-border p-6">
              <p class="m-0 font-mono text-xs uppercase tracking-wide text-accent">{platform.label}</p>
              <p class="mt-3 mb-0 text-lg font-medium">{platform.title}</p>
              <p class="mt-2 mb-0 text-sm leading-relaxed text-muted-foreground">{platform.body}</p>
            </div>
          ))
        }
        <div class="rounded-xl bg-muted p-6 sm:col-span-2 lg:col-span-3">
          <p class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground">Also inside</p>
          <p class="mt-3 mb-0 text-sm leading-relaxed text-muted-foreground">
            Circuit Relay v2 reservations and circuits, StrictSign Gossipsub pinned against go-libp2p, signed presence beacons
            and mDNS discovery — with <code class="font-mono text-[0.9em] text-foreground">unsafe</code> denied in every crate.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-border py-16 sm:py-20" aria-labelledby="start-title">
      <p class="m-0 font-mono text-xs uppercase tracking-wide text-muted-foreground">Quickstart</p>
      <h2 class="mt-4 mb-0 text-2xl font-medium leading-tight tracking-tighter sm:text-3xl" id="start-title">
        Connect, then drive.
      </h2>
      <p class="mt-4 mb-0 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        Connect to a peer, wait for it, ping it. Both snippets are shown verbatim from code in the
        repository: the dialer this site compiles in CI, and the Node example package.
      </p>
      {/* Radio inputs, so the tabs work with no script and answer arrow keys.
          The wrapper reads which one is checked, since the header labels are
          not siblings of the inputs. */}
      <div class="group mt-8 overflow-hidden rounded-xl border border-border">
        <input class="peer/rust sr-only" type="radio" name="quickstart" id="quickstart-rust" checked />
        <input class="peer/node sr-only" type="radio" name="quickstart" id="quickstart-node" />
        <div class="flex items-center justify-between gap-4 border-b border-border bg-muted px-4 py-3">
          <div class="flex gap-4">
            <label
              class="cursor-pointer font-mono text-xs text-muted-foreground underline-offset-4 group-has-[#quickstart-rust:checked]:text-foreground group-has-[#quickstart-rust:focus-visible]:underline"
              for="quickstart-rust"
            >dialer.rs</label>
            <label
              class="cursor-pointer font-mono text-xs text-muted-foreground underline-offset-4 group-has-[#quickstart-node:checked]:text-foreground group-has-[#quickstart-node:focus-visible]:underline"
              for="quickstart-node"
            >ping.mjs</label>
          </div>
          <span class="hidden font-mono text-xs text-muted-foreground sm:group-has-[#quickstart-rust:checked]:block">cargo add minip2p-rs</span>
          <span class="hidden font-mono text-xs text-muted-foreground sm:group-has-[#quickstart-node:checked]:block">pnpm add @minip2p/node</span>
        </div>
        <pre class="m-0 hidden overflow-x-auto p-5 font-mono text-xs leading-relaxed peer-checked/rust:block sm:text-[0.8125rem]"><code>{dialer}</code></pre>
        <pre class="m-0 hidden overflow-x-auto p-5 font-mono text-xs leading-relaxed peer-checked/node:block sm:text-[0.8125rem]"><code>{ping}</code></pre>
      </div>
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          href="/rust/install"
        >Rust quickstart <span aria-hidden="true">↗</span></a>
        <a
          class="text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          href="/typescript/start"
        >TypeScript quickstart <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>

  <footer class="mx-auto max-w-7xl shrink-0 px-6 py-6 text-center text-xs text-muted-foreground lg:px-8">
    Made with <svg class="inline-block size-3.5 fill-accent align-middle" viewBox="0 0 24 24" role="img" aria-label="love"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z" /></svg> by <a
      class="text-foreground no-underline underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      href="https://deepso.sh"
      target="_blank"
      rel="noopener noreferrer"
    >deepso</a>
  </footer>
</PageLayout>
