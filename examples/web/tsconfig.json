{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    // Read @minip2p/web and @minip2p/core from source, so CI type-checks
    // this example without building the bindings first.
    "customConditions": ["minip2p-source"],
    "lib": ["DOM", "DOM.Iterable", "ES2023", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022"
  },
  "include": ["src/*.ts", "vite.config.ts"]
}
