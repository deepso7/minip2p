{
  "name": "minip2p-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "clean:all": "./scripts/clean.sh",
    "example": "pnpm --filter react-native-minip2p-example",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "test": "turbo run test",
    "test:workflows": "node --test bindings/ts/tests/workflows/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "rn:android": "pnpm --filter @minip2p/react-native ubrn:android",
    "rn:generate": "pnpm --filter @minip2p/react-native ubrn:generate",
    "rn:ios": "pnpm --filter @minip2p/react-native ubrn:ios",
    "docs:dev": "pnpm --filter minip2p-docs dev",
    "docs:check": "pnpm --filter minip2p-docs check",
    "build:bindings": "turbo run build --filter=\"@minip2p/*\""
  },
  "devDependencies": {
    "js-yaml": "5.5.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.16.1"
}
