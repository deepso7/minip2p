{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".config/tsconfig.base.json"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.build.json"],
      "outputs": ["dist/**", "lib/**"]
    },
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "android",
        "!android/build",
        "src/*.ts",
        "src/*.tsx",
        "$TURBO_ROOT$/examples/react-native/package.json",
        "$TURBO_ROOT$/examples/react-native/android",
        "!$TURBO_ROOT$/examples/react-native/android/.gradle",
        "!$TURBO_ROOT$/examples/react-native/android/build",
        "!$TURBO_ROOT$/examples/react-native/android/app/build"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "*.podspec",
        "ios",
        "src/*.ts",
        "src/*.tsx",
        "$TURBO_ROOT$/examples/react-native/package.json",
        "$TURBO_ROOT$/examples/react-native/ios",
        "!$TURBO_ROOT$/examples/react-native/ios/build",
        "!$TURBO_ROOT$/examples/react-native/ios/Pods"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "$TURBO_ROOT$/bindings/ts/test-fixtures/**",
        "$TURBO_ROOT$/bindings/ts/core/src/**"
      ],
      "outputs": []
    },
    "@minip2p/node#test": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "minip2p-docs#build": {
      "cache": false,
      "outputs": ["dist/**"],
      "passThroughEnv": ["GITHUB_TOKEN"]
    }
  }
}
